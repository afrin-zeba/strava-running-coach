# Personal, localhost-only Strava REST app. Never use VITE_ for server secrets.
MILEMARK_APP_ORIGIN=http://localhost:8888
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MILEMARK_SESSION_KEY=
# Create an app at https://www.strava.com/settings/api; callback domain: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
