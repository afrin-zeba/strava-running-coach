{
  "name": "milemark-running-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "netlify dev --offline",
    "dev:ui": "vite --host 127.0.0.1 --strictPort",
    "build": "astryx theme build src/theme.ts --out src/theme-built/milemark.css && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "astryx": "astryx",
    "dev:netlify": "netlify dev --offline",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@netlify/blobs": "^11.1.11",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "netlify-cli": "^27.20.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  }
}
